{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel", "source": "__LOGO__", "width": 32, "height": 19,
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "bar": {
      "char": { "elapsed": "━", "total": "─" },
      "border": { "left": "", "right": " " },
      "color": { "total": "38;2;45;65;85" },
      "width": 10
    },
    "percent": {
      "type": ["bar", "num"], "green": 60, "yellow": 85,
      "color": { "green": "38;2;79;179;217", "yellow": "38;2;240;198;116", "red": "38;2;255;107;107" }
    }
  },
  "modules": [
    { "type": "custom", "format": "\u001b[3;38;2;133;212;227m__GREET__\u001b[0m" },
    { "type": "title", "format": "\u001b[38;2;29;106;150m\u001b7╭─────────────────────────────────────────────────────────────────────╮\u001b8╭─ \u001b[1;38;2;79;179;217m{user-name}\u001b[22;38;2;133;212;227m@\u001b[1;38;2;177;240;247m{host-name} \u001b[22;38;2;29;106;150m─ \u001b[1;38;2;79;179;217mSYSTEM \u001b[22m" },
    { "type": "os",       "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;79;179;217m\uf17a OS        " },
    { "type": "kernel",   "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;79;179;217m\uf013 Kernel    " },
    { "type": "shell",    "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;79;179;217m\uf120 Shell     " },
    { "type": "terminal", "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;79;179;217m\uf489 Terminal  " },
    { "type": "custom", "format": "\u001b[38;2;29;106;150m├─ \u001b[1;38;2;133;212;227mHARDWARE \u001b[22;38;2;29;106;150m──────────────────────────────────────────────────────────┤" },
    { "type": "host",     "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;133;212;227m\uf109 Host      " },
    { "type": "cpu",      "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;133;212;227m\uf2db CPU       " },
    { "type": "gpu",      "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;133;212;227m\uf26c GPU       " },
    { "type": "memory",   "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;133;212;227m\uf0e4 Memory    " },
    { "type": "disk",     "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;133;212;227m\uf0a0 Disk      " },
    { "type": "custom", "format": "\u001b[38;2;29;106;150m├─ \u001b[1;38;2;177;240;247mSTATUS \u001b[22;38;2;29;106;150m────────────────────────────────────────────────────────────┤" },
    { "type": "datetime", "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;177;240;247m\uf073 Date      ", "format": "{weekday}, {day-in-month} {month-name} {year}" },
    { "type": "uptime",   "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;177;240;247m\uf017 Uptime    " },
    { "type": "battery",  "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;177;240;247m\uf240 Battery   ", "format": "{capacity-bar} {capacity} [{status}]" },
    { "type": "localip",  "key": "\u001b7\u001b[70C\u001b[38;2;29;106;150m│\u001b8\u001b[38;2;29;106;150m│ \u001b[38;2;177;240;247m\uf0ac IP        ", "showPrefixLen": false },
    { "type": "custom", "format": "\u001b[38;2;29;106;150m\u001b7╰─────────────────────────────────────────────────────────────────────╯\u001b8╰─ \u001b[38;2;11;60;93m● \u001b[38;2;29;106;150m● \u001b[38;2;46;139;192m● \u001b[38;2;79;179;217m● \u001b[38;2;133;212;227m● \u001b[0m" },
    { "type": "custom", "format": "\u001b[38;2;79;179;217m\u275d \u001b[3;38;2;224;247;250m__QUOTE__\u001b[23;38;2;79;179;217m \u275e\u001b[0m" }
  ]
}